# Environment
NODE_ENV=development
PORT=3000

# HubSpot OAuth Configuration
HUBSPOT_CLIENT_ID=your_client_id_here
HUBSPOT_CLIENT_SECRET=your_client_secret_here
HUBSPOT_REDIRECT_URI=http://localhost:3000/oauth/callback
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.objects.companies.read crm.objects.companies.write crm.objects.deals.read crm.objects.deals.write timeline

# App Secret (for signing webhooks, sessions)
APP_SECRET=your_app_secret_here

# Database (optional - for token storage)
DATABASE_URL=

# Logging
LOG_LEVEL=info
